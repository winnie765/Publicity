# Server-only settings. Never commit .env.local or use NEXT_PUBLIC_ for secrets.
DATABASE_URL=
DIRECT_URL=
# A strong password of at least 16 characters. Empty means the Workspace stays locked.
WORKSPACE_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_PROVIDER=gemini
AI_DAILY_LIMIT=40

# Optional: a separate 32+ character token for an authenticated report scheduler.
REPORT_AUTOMATION_SECRET=

# Optional non-Sites image provider. Use a private bucket; keys remain server-only.
# Hosted Sites uses its R2 BUCKET binding instead, without additional secrets.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=portal-images

# Select only after applying supabase/migrations and verifying the data transfer.
# Missing/unreachable Supabase credentials fail closed when selected.
DATABASE_PROVIDER=
# Set DATABASE_PROVIDER=supabase, SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY in production.
