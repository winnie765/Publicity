generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Record {
  masterLinks RecordMasterLink[]
  id        String   @id
  kind      String
  payload   Json
  recordDate DateTime? @db.Date @map("record_date")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([kind])
  @@index([recordDate])
  @@map("portal_records")
}

model Audit {
  id       String   @id @default(uuid())
  actor    String
  action   String
  recordId String   @map("record_id")
  date     DateTime @default(now())

  @@index([date])
  @@map("portal_audit")
}

// Legacy archival table only. Account histories live in Record(kind=followers),
// keyed by payload.account plus recordDate; application code cannot write a pooled snapshot.
model FacebookFollower {
  id String @id @default(uuid())
  snapshotDate DateTime @unique @db.Date @map("snapshot_date")
  followerCount Int @map("follower_count")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("facebook_followers")
}

model AICache {
 id String @id
 payload String
 expiresAt DateTime @map("expires_at")
 leaseUntil DateTime @map("lease_until")
 leaseToken String @map("lease_token")
 requests Int
 @@map("ai_cache")
}

model MasterData {
 id String @id
 module String
 name String
 aliases Json @default("[]")
 references RecordMasterLink[]
 @@unique([module,name])
 @@map("portal_master_data")
}

model RecordMasterLink {
 recordId String @map("record_id")
 field String
 masterId String @map("master_id")
 record Record @relation(fields:[recordId], references:[id], onDelete:Cascade, onUpdate:NoAction)
 master MasterData @relation(fields:[masterId], references:[id], onDelete:NoAction, onUpdate:NoAction)
 @@id([recordId,field])
 @@index([masterId], map:"portal_record_master_links_master_idx")
 @@map("portal_record_master_links")
}
